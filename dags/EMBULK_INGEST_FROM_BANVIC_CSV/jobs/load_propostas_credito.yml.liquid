in:
  type: file
  path_prefix: ../../data/propostas_credito.csv
  parser:
    type: csv
    delimiter: ','
    quote: '"'
    escape: '"'
    header_line: true
    charset: UTF-8
    newline: LF
    trim_if_not_quoted: false
    allow_extra_columns: false
    allow_optional_columns: false
    columns:
    - {name: cod_proposta, type: long}
    - {name: cod_cliente, type: long}
    - {name: cod_colaborador, type: long}
    - {name: data_entrada_proposta, type: timestamp, format: '%Y-%m-%d %H:%M:%S %z'}
    - {name: taxa_juros_mensal, type: double}
    - {name: valor_proposta, type: double}
    - {name: valor_financiamento, type: double}
    - {name: valor_entrada, type: double}
    - {name: valor_prestacao, type: double}
    - {name: quantidade_parcelas, type: long}
    - {name: carencia, type: long}
    - {name: status_proposta, type: string}

filters:
  - type: add_time
    to_column:
      name: _ingested_at_ts
      type: timestamp
    from_value:
      mode: upload_time

out:
  type: postgresql
  host: postgres-target.airflow.svc.cluster.local
  user: banvic_dw_user
  password: "{ env.DB_PASSWORD }"
  database: banvic_dw
  schema: stage
  table: stg_propostas_credito
  mode: replace
  port: 5432
  driver_path: /app/bin/postgresql-42.7.3.jar
