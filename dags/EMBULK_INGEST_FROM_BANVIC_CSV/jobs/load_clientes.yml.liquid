in:
  type: file
  path_prefix: ../../data/clientes.csv
  parser:
    type: csv
    delimiter: ','
    quote: '"'
    escape: '"'
    header_line: true
    charset: UTF-8
    newline: LF
    trim_if_not_quoted: false
    allow_extra_columns: false
    allow_optional_columns: false
    columns:
    - {name: cod_cliente, type: long}
    - {name: primeiro_nome, type: string}
    - {name: ultimo_nome, type: string}
    - {name: email, type: string}
    - {name: tipo_cliente, type: string}
    - {name: data_inclusao, type: timestamp, format: '%Y-%m-%d %H:%M:%S %z'}
    - {name: cpfcnpj, type: string}
    - {name: data_nascimento, type: timestamp, format: '%Y-%m-%d'}
    - {name: endereco, type: string}
    - {name: cep, type: string}

filters:
  - type: add_time
    to_column:
      name: _ingested_at_ts
      type: timestamp
    from_value:
      mode: upload_time

out:
  type: postgresql
  host: postgres-target.airflow.svc.cluster.local
  user: banvic_dw_user
  password: "{ env.DB_PASSWORD }"
  database: banvic_dw
  schema: stage
  table: stg_clientes
  mode: replace
  port: 5432
  driver_path: /app/bin/postgresql-42.7.3.jar
