in:
  type: sftp
  host: "{{ env.SFTP_HOST }}"
  user: "{{ env.SFTP_USER }}"
  password: "{{ env.SFTP_PASSWORD }}"
  port: 22
  path_prefix: /upload/data/agencias.csv
  parser:
    type: csv
    delimiter: ','
    quote: '"'
    escape: '"'
    header_line: true
    charset: UTF-8
    newline: LF
    trim_if_not_quoted: false
    allow_extra_columns: false
    allow_optional_columns: false
    columns:
    - {name: cod_agencia, type: long}
    - {name: nome, type: string}
    - {name: endereco, type: string}
    - {name: cidade, type: string}
    - {name: uf, type: string}
    - {name: data_abertura, type: timestamp, format: '%Y-%m-%d'}
    - {name: tipo_agencia, type: string}

filters:
  - type: add_time
    to_column:
      name: _ingested_at_ts
      type: timestamp
    from_value:
      mode: upload_time

out:
  type: postgresql
  host: "{{ env.DB_HOST }}"
  user: "{{ env.DB_USER }}"
  password: "{{ env.DB_PASSWORD }}"
  database: "{{ env.DB_NAME }}"
  schema: stage
  table: stg_agencias
  mode: replace
  port: "{{ env.DB_PORT }}"
  driver_path: /opt/embulk/drivers/postgresql-42.7.3.jar
